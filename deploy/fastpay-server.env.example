# fastpay-server 运行时环境变量模板
#
# 用法：复制到服务器上的 /etc/fastpay/fastpay-server.env，把 <> 里的内容换成真实值，然后：
#   chown root:fastpay /etc/fastpay/fastpay-server.env
#   chmod 640 /etc/fastpay/fastpay-server.env
#
# 【真实的那份文件绝对不能提交进仓库】
#
# 【值一律用引号包住】这个文件不只被 systemd 读，运维脚本也会用 `set -a; . 这个文件` 把它
# 读进来（deploy/verify-release.sh、docs/DEPLOY.md 第三节的备份/迁移命令都是这么干的）。
# 那等于交给命令行去解释，值里只要出现 & | ; # 空格 这些符号，不加引号就会被当成命令语法：
#   · & 最坑 —— MySQL 的地址常带它（?useSSL=false&serverTimezone=UTC），不加引号会被当成
#     「把前半句丢到后台跑」。实测结果是 DB_URL 这个变量在脚本里压根没被设上，读到的是空的，
#     然后验证脚本提示「DB_URL 格式不对」。地址本身其实是好的，人照着提示去改地址只会越改越糊涂。
#   · 口令里带 & # 空格 的同理，而且失败得更安静。
# 规矩：口令用单引号（'）—— 里面的 $ ` \ 一律按字面走；其余的值用双引号（"）。
# 口令里真有单引号，就改用双引号，并在 $ ` \ 每个符号前各加一个反斜杠。

# 用哪套配置。本项目没有 spring-cloud，bootstrap.yml 不生效，只有这个变量说了算。
SPRING_PROFILES_ACTIVE=prod

# 只监听本机回环地址，不对公网暴露，外部访问一律走 nginx 反向代理
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=7001

# 数据库。这三个变量在 application-prod.yml 里故意没有默认值：
# 没配就直接启动失败，避免连错库或者用默认密码上线。
DB_DRIVER=org.postgresql.Driver
DB_URL="jdbc:postgresql://<数据库地址>:5432/<库名>"
DB_USERNAME="<用户名>"
DB_PASSWORD='<密码>'

# 哪天换成 MySQL，照着下面这两行抄 —— 注意引号一个都不能省，那串 & 全靠它们才读得对。
# （提醒：deploy/verify-release.sh 这个发版验证脚本目前只认 PostgreSQL，换库前先看
#   docs/RELEASE_VERIFY.md 开头那段说明。）
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_URL="jdbc:mysql://<数据库地址>:3306/<库名>?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai"

# 登录令牌的签名密钥，用 `openssl rand -hex 48` 生成。
# 和上面数据库那几项一样没有默认值：没配就直接启动失败，不会静默退回一个公开的弱密钥。
FASTPAY_JWT_SECRET="<openssl rand -hex 48 生成的随机串>"

# 对外域名。改域名时这两个也要一起改，否则支付页跳转和回调地址会指到旧域名。
FASTPAY_PAGE_DOMAIN="https://pay.copliot.cloud/fastpay-merchant"
FASTPAY_NOTIFY_CALLBACK_URL="https://pay.copliot.cloud/fastpay-server/api/notify/callback"

# 接口文档开关。生产环境保持 false —— 接口本身有登录保护，但把完整接口清单公开
# 等于把系统地图送给攻击者。application-prod.yml 里默认就是 false，这里显式写出来
# 是为了让人一眼看到有这么个开关；排查问题需要临时打开时改成 true 再重启。
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

# 前端白名单（MTM-177）：只有这里列出的域名才能带用户凭证调后端接口。
# application-prod.yml 默认已经放行 https://pay.copliot.cloud，当前生产就这一个前端来源，
# 所以这个变量不配也能工作。以后加子域名、临时联调第三方前端时才需要在这里覆盖：
#   FASTPAY_CORS_ALLOWED_ORIGINS="https://pay.copliot.cloud,https://admin.copliot.cloud"
# 千万不要写成 "*"（后端会拒绝启动），通配 + 允许带凭证等同修复前的洞。
