# fastpay-server 运行时环境变量模板
#
# 用法：复制到服务器上的 /etc/fastpay/fastpay-server.env，把 <> 里的内容换成真实值，然后：
#   chown root:fastpay /etc/fastpay/fastpay-server.env
#   chmod 640 /etc/fastpay/fastpay-server.env
#
# 【真实的那份文件绝对不能提交进仓库】

# 用哪套配置。本项目没有 spring-cloud，bootstrap.yml 不生效，只有这个变量说了算。
SPRING_PROFILES_ACTIVE=prod

# 只监听本机回环地址，不对公网暴露，外部访问一律走 nginx 反向代理
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=7001

# 数据库。这三个变量在 application-prod.yml 里故意没有默认值：
# 没配就直接启动失败，避免连错库或者用默认密码上线。
DB_DRIVER=org.postgresql.Driver
DB_URL=jdbc:postgresql://<数据库地址>:5432/<库名>
DB_USERNAME=<用户名>
DB_PASSWORD=<密码>

# 登录令牌的签名密钥，用 `openssl rand -hex 48` 生成。
# 和上面数据库那几项一样没有默认值：没配就直接启动失败，不会静默退回一个公开的弱密钥。
FASTPAY_JWT_SECRET=<openssl rand -hex 48 生成的随机串>

# 对外域名。改域名时这两个也要一起改，否则支付页跳转和回调地址会指到旧域名。
FASTPAY_PAGE_DOMAIN=https://pay.copliot.cloud/fastpay-merchant
FASTPAY_NOTIFY_CALLBACK_URL=https://pay.copliot.cloud/fastpay-server/api/notify/callback

# 接口文档开关。生产环境保持 false —— 接口本身有登录保护，但把完整接口清单公开
# 等于把系统地图送给攻击者。application-prod.yml 里默认就是 false，这里显式写出来
# 是为了让人一眼看到有这么个开关；排查问题需要临时打开时改成 true 再重启。
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
