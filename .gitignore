# 此为注释，将被 Git 忽略
# /结尾表示是目录，忽略目录和目录下的所有文件
# /开头表示根目录，否则是 .gitignore 的相对目录
# !开头表示反选
*.class
*.ear
.idea/
target/
*.iml
*.ipr
*.iws
*.log
.svn/
rebel.xml
.rebel-remote.xml.*
/logs
.settings/
/bin
.project
.classpath
.factorypath
.tgitconfig
.springBeans
node_modules
dist

# unplugin-auto-import / unplugin-vue-components 自动生成的类型声明，跟机器有关，不该进仓库
auto-imports.d.ts
components.d.ts

# 数据库连接信息，不能进仓库
PG.txt

# 操作系统 / 编辑器产生的杂物，跟代码无关
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.swp
*.swo
