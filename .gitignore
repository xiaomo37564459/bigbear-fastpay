# 此为注释– 将被Git 忽略
# /结尾表示是目录，忽略目录和目录下的所有件
# /开头表示根目录，否则是.gitignore的相对目录
# !开头表示反选
*.class
*.ear
.idea/
target/
*.iml
*.ipr
*.iws
*.log
.svn/
rebel.xml
.rebel-remote.xml.*
/logs
.settings/
/bin
.project
.classpath
.factorypath
.tgitconfig
.springBeans
node_modules
dist

# unplugin-auto-import / unplugin-vue-components 自动生成的类型声明，跟机器有关，不该进仓库
auto-imports.d.ts
components.d.ts

# vite 读配置时会在配置文件旁边写一个临时文件，正常跑完会自己删掉；
# 测试被强行中断时可能残留，别让它混进仓库
vite.config.js.timestamp-*

# 数据库连接信息，不能进仓库
PG.txt

# 操作系统生成的文件
.DS_Store
Thumbs.db
desktop.ini

# 真实配置、密钥、证书私钥，绝不能进仓库。判断标准见 docs/SECRETS.md
# 注意：这里只挡文件名，挡不住你把密码直接写进 .md 或 .yml 里 —— 提交前还是要自己扫一遍
.env
*.env
!*.env.example
*.pem
*.key
*.p12
*.jks
id_rsa*
id_ed25519*
.vscode/
*.swp
*.swo
